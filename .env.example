# local (default when unset): personal workspace without accounts; one-click desktop launch.
# hosted (opt-in): verified accounts, per-user SSH keys, and browser terminals on phones.
# Hosted mode connects from this server to SSH targets; it cannot launch users' desktop apps.
OUTPOST_MODE=local
HOST=127.0.0.1
PORT=3000

# Defaults to ~/.outpost. Local mode uses targets.json; hosted mode uses accounts.sqlite
# and users/<id>/ with target settings, private SSH keys, and known_hosts.
# Use separate directories for separate deployments. Run one process per directory.
# OUTPOST_DATA_DIR=/absolute/path/to/outpost-state

# Hosted development defaults to http://127.0.0.1:5173 (npm run dev), or
# http://127.0.0.1:3000 (npm start). Email is simulated on loopback when unconfigured.
# Set these for hosted production behind an HTTPS reverse proxy:
# NODE_ENV=production
# PUBLIC_APP_URL=https://outpost.example.com
# ENGAGE_LAB_USERNAME=your-engagelab-username
# ENGAGE_LAB_API_KEY=your-engagelab-api-key
# ENGAGE_LAB_FROM_EMAIL=Outpost <no-reply@example.com>

# Optional: trusted reverse proxy IPs/CIDRs, comma-separated, for client rate limits.
# Restrict this to the actual proxy addresses; forwarding headers are otherwise ignored.
# OUTPOST_TRUST_PROXY=127.0.0.1,::1

# Optional override for the key that encrypts uploaded SSH private keys.
# When unset, the first upload generates a persistent 0600 key at
# OUTPOST_DATA_DIR/terminal-keys/master-key. Back up the entire data directory.
# To manage the key separately, generate once with: openssl rand -base64 32
# Keep the override stable and back it up; encrypted uploads require the same key.
# OUTPOST_TERMINAL_ENCRYPTION_KEY=your-32-byte-base64-key
