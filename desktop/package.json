{
  "name": "outpost-desktop",
  "productName": "Outpost",
  "version": "1.3.1",
  "description": "Outpost native terminal workspace",
  "author": "Outpost contributors",
  "license": "MIT",
  "private": true,
  "scripts": {
    "helper": "node scripts/build-helper.mjs",
    "dev": "npm run helper && cargo run --locked",
    "build": "npm run helper && cargo build --locked --release",
    "package": "npm run build && node scripts/package.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && cargo check --locked",
    "test": "npm run helper && node --import tsx --test tests/session.test.ts && cargo test --locked",
    "test:ui": "cargo test --locked --features ui-tests --test workspace"
  },
  "dependencies": {
    "@xterm/headless": "6.0.0",
    "@xterm/addon-serialize": "^0.14.0",
    "typebox": "^1.3.37",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
