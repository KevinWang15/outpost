{
  "name": "outpost",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently --kill-others --names api,web \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite",
    "dev:server": "tsx watch --include=backend/** backend/server.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.tests.json",
    "build": "npm run typecheck && npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "node scripts/build-server.mjs",
    "start": "node --enable-source-maps dist/server/server.js",
    "lint": "eslint . --max-warnings 0",
    "preview": "vite preview",
    "dev:debug": "tsx watch --inspect-brk=127.0.0.1:9229 --include=backend/** backend/server.ts",
    "test": "node --import tsx --test tests/*.test.js",
    "check": "npm run lint && npm run build && npm test",
    "test:integration": "node --import tsx --test tests/ssh.integration.js tests/software.integration.js tests/web-terminal.integration.js",
    "test:deployment": "node --test tests/deployment.integration.js",
    "test:ui": "playwright test",
    "test:desktop": "xvfb-run -a node --import tsx --test tests/desktop.integration.js",
    "test:local": "node --import tsx --test tests/local.integration.js tests/keyboard.integration.js tests/activity.integration.js",
    "test:coding": "node --import tsx --test tests/coding-cli.integration.js",
    "logo:generate": "node scripts/logo/generate.mjs",
    "docs:capture": "node --import tsx scripts/readme/capture.mjs",
    "promo:capture": "npm --prefix promo-v2 run capture",
    "promo:narrate": "npm --prefix promo-v2 run narrate",
    "promo:music": "npm --prefix promo-v2 run music",
    "promo:stills": "npm --prefix promo-v2 run stills --",
    "promo:render": "npm --prefix promo-v2 run render --",
    "promo:preview": "npm --prefix promo-v2 run preview --"
  },
  "dependencies": {
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@fastify/cookie": "^11.1.3",
    "@fastify/static": "^10.1.6",
    "@fastify/websocket": "^11.3.4",
    "@lezer/highlight": "^1.2.5",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "ajv": "8.20.0",
    "codemirror": "^6.0.2",
    "dotenv": "^18.0.8",
    "fastify": "^5.12.7",
    "lucide-react": "^1.57.0",
    "open": "^11.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ssh2": "^1.17.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ssh2": "^1.15.6",
    "@types/ws": "^8.18.2",
    "@typescript/native": "npm:typescript@~7.0.2",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "sass": "^1.105.1",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  }
}
