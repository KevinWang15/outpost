{
  "name": "outpost",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently --kill-others --names api,web \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite",
    "dev:server": "tsx watch --include=backend/** backend/server.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.tests.json && tsc --noEmit -p machine/tsconfig.json",
    "build": "npm run typecheck && npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "node scripts/build-server.mjs",
    "start": "node --enable-source-maps dist/server/server.js",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "test": "node --import tsx --test 'tests/unit/*.test.ts' 'tests/machine/*.test.ts'",
    "test:integration": "node --import tsx --test 'tests/integration/*.test.ts'",
    "test:ui": "playwright test",
    "test:desktop": "playwright test --config playwright.desktop.config.ts",
    "test:mobile": "playwright test --config playwright.mobile.config.ts",
    "check": "npm run lint && npm run lint:python && npm run build && npm test",
    "logo:generate": "node scripts/logo/generate.mjs",
    "docs:capture": "node scripts/screenshots.mjs",
    "dev:debug": "tsx watch --inspect=127.0.0.1:9229 --include=backend/** backend/server.ts",
    "lint:python": "ruff check tests && ruff format --check tests",
    "format": "prettier --write . && ruff format tests && ruff check --fix tests",
    "build:terminal": "npm exec --yes --package=bun@1.4.3 -- node scripts/build-terminal.mjs"
  },
  "dependencies": {
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@fastify/cookie": "^11.1.2",
    "@fastify/static": "^10.1.5",
    "@fastify/websocket": "^11.3.3",
    "@huggingface/transformers": "4.3.2",
    "@kevinwang15/log-viewer": "0.3.0",
    "@lezer/highlight": "^1.2.5",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "https://github.com/KevinWang15/xterm.js/releases/download/outpost-6.0.1/xterm-xterm-6.0.1.tgz",
    "ajv": "8.20.0",
    "boring-avatars": "2.0.4",
    "codemirror": "^6.0.2",
    "dotenv": "^18.0.4",
    "fastify": "^5.12.5",
    "lucide-react": "^1.49.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sqlite-vec": "0.1.6",
    "typebox": "^1.3.37",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@agentclientprotocol/sdk": "2.5.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/bun": "1.4.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@typescript/native": "npm:typescript@~7.0.2",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "@xterm/headless": "6.0.0",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "prettier": "^3.9.10",
    "sass": "^1.105.0",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  }
}
